---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import {reviews, business} from '../data/site';
---

<section class="on-light bg-stone py-24 text-ink md:py-32" aria-labelledby="reviews-h">
  <div class="mx-auto max-w-[1680px] px-5 md:px-14">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div id="reviews-h"><SectionHead eyebrow="Google reviews" lines={[{t: 'Trusted for quality.'}, {t: 'Recommended for results.', i: true}]} /></div>
      <a href={business.googleReview} target="_blank" rel="noopener" class="btn btn-red" data-reveal>Leave us a review <Icon name="arrow-up-right" class="size-4" /></a>
    </div>
    <ul class="mt-16 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        reviews.map((r, i) => (
          <li class="flex flex-col justify-between bg-paper p-7" data-reveal style={`--d: ${i * 0.08}s`}>
            <div>
              <div class="flex gap-1 text-red" role="img" aria-label="5 out of 5 stars">
                {[0, 1, 2, 3, 4].map(() => <Icon name="star" class="size-4" />)}
              </div>
              <blockquote class="mt-5 text-[18px] leading-relaxed">“{r.text}”</blockquote>
            </div>
            <p class="caps mt-6 text-ink/70">{r.name}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-[14px] text-ink/65">Reviews paraphrased from our Google Business profile.</p>
  </div>
</section>

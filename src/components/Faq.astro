---
import Icon from './Icon.astro';
interface Props {
  items: {q: string; a: string}[];
}
---

<div class="divide-y divide-ink/15 border-y border-ink/15">
  {
    Astro.props.items.map((f) => (
      <details class="group py-2" data-reveal>
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-3 text-[19px] font-semibold [&::-webkit-details-marker]:hidden">
          {f.q}
          <Icon name="plus" class="size-5 shrink-0 text-red transition-transform duration-300 group-open:rotate-45" />
        </summary>
        <p class="max-w-[70ch] pb-5 text-ink/80">{f.a}</p>
      </details>
    ))
  }
</div>

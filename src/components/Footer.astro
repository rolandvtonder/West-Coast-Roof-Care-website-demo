---
import Icon from './Icon.astro';
import {business, nav, services, towns} from '../data/site';
const year = new Date().getFullYear();
---

<footer data-footer class="relative overflow-hidden bg-ink text-white">
  <!-- Closing CTA -->
  <div class="mx-auto max-w-[1680px] px-5 pt-24 pb-16 md:px-14 md:pt-32">
    <p class="caps text-white/60" data-reveal>Ready to protect your property?</p>
    <h2 class="display mt-4 text-[clamp(48px,7vw,124px)]" data-reveal>
      <span class="block">Let's keep your</span>
      <span class="it block">roof watertight.</span>
    </h2>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      <a href="/contact/" class="btn btn-red">Request a free quote <Icon name="arrow" class="size-4" /></a>
      <a href={`tel:${business.phoneIntl}`} class="btn btn-ghost"><Icon name="phone" class="size-4" /> {business.phone}</a>
      <a href={business.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="chat" class="size-4" /> WhatsApp</a>
    </div>
  </div>

  <div class="mx-auto grid max-w-[1680px] gap-12 border-t border-white/12 px-5 py-14 sm:grid-cols-2 md:px-14 lg:grid-cols-4">
    <div>
      <p class="caps text-white/55">Contact</p>
      <address class="mt-4 space-y-3 not-italic">
        <p class="font-semibold">{business.legalName}</p>
        <a href={`tel:${business.phoneIntl}`} class="flex items-center gap-3 hover:text-red-bright"><Icon name="phone" class="size-4 text-red-bright" /> {business.phone} ({business.contact})</a>
        <a href={`mailto:${business.email}`} class="flex items-center gap-3 hover:text-red-bright"><Icon name="mail" class="size-4 text-red-bright" /> {business.email}</a>
        <p class="flex items-center gap-3"><Icon name="pin" class="size-4 text-red-bright" /> {business.town}, {business.region}, {business.postcode}</p>
        <p class="flex items-center gap-3"><Icon name="clock" class="size-4 text-red-bright" /> {business.hours}</p>
      </address>
    </div>
    <div>
      <p class="caps text-white/55">Services</p>
      <ul class="mt-4 space-y-2">
        {services.map((s) => <li><a href={`/services/${s.slug}/`} class="hover:text-red-bright">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="caps text-white/55">Company</p>
      <ul class="mt-4 space-y-2">
        {nav.filter((n) => n.href !== '/').map((n) => <li><a href={n.href} class="hover:text-red-bright">{n.label}</a></li>)}
        <li><a href={business.certificate} target="_blank" rel="noopener" class="hover:text-red-bright">Asbestos contractor certificate</a></li>
      </ul>
    </div>
    <div>
      <p class="caps text-white/55">Areas we serve</p>
      <ul class="mt-4 space-y-2">
        {towns.map((t) => <li><a href={`/areas/${t.slug}/`} class="hover:text-red-bright">Roofing {t.name}</a></li>)}
        <li><a href="/areas/" class="text-white/70 hover:text-red-bright">+ greater Western Cape</a></li>
      </ul>
      <p class="caps mt-8 text-white/55">Follow us</p>
      <div class="mt-3 flex flex-wrap gap-5">
        {business.socials.map((s) => <a href={s.href} target="_blank" rel="noopener" class="caps py-1 hover:text-red-bright">{s.name}</a>)}
      </div>
    </div>
  </div>

  <!-- Wordmark spans the full width at every size (measured, not guessed in vw). -->
  <div class="px-5 md:px-14" aria-hidden="true">
    <!-- Drawn via ::before so the faint decorative text isn't treated as readable copy. -->
    <span data-fit data-text="West Coast Roof Care" class="display inline-block leading-[0.8] whitespace-nowrap text-white/[0.07] before:content-[attr(data-text)]"></span>
  </div>
  <p class="caps px-5 py-6 pb-24 text-white/50 md:px-14 md:pb-8">
    © {year} {business.legalName} · Roofer & waterproofer, {business.town}
  </p>
</footer>

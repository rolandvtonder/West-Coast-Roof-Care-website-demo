---
/** One stroke icon set (Lucide geometry, 2px stroke) used everywhere. Decorative by default. */
interface Props {
  name: 'phone' | 'chat' | 'arrow' | 'arrow-up-right' | 'mail' | 'pin' | 'clock' | 'check' | 'shield' | 'star' | 'plus' | 'droplet' | 'home' | 'file' | 'hardhat';
  class?: string;
  label?: string;
}

---
import {nav, services, business} from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const slab = 'absolute inset-y-0 right-0 w-[min(40vw,540px)] max-md:w-full translate-x-[104%] transition-transform duration-[800ms] ease-wipe group-data-[open]:translate-x-0';
---

<!-- Three slabs wipe in from the right one after another (ink → red → paper);
     the paper slab stays and holds the links. Closing runs the reverse, faster. -->
<div id="site-menu" class="group pointer-events-none fixed inset-0 z-50 data-[open]:pointer-events-auto">
  <svg class="absolute size-0" aria-hidden="true">
    <filter id="ripple" x="-5%" y="-30%" width="110%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="2" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
  </svg>

  <button type="button" data-menu-close tabindex="-1" aria-label="Close menu" class="absolute inset-0 cursor-default bg-ink/0 transition-colors duration-700 group-data-[open]:bg-ink/40"></button>

  <div class={`${slab} bg-ink [transition-delay:0.12s] group-data-[open]:[transition-delay:0s]`}></div>
  <div class={`${slab} bg-red [transition-delay:0.06s] group-data-[open]:[transition-delay:0.09s]`}></div>
  <nav
    class={`${slab} on-light flex flex-col justify-between overflow-y-auto bg-paper px-8 pt-28 pb-28 text-ink md:px-12 [transition-delay:0s] group-data-[open]:[transition-delay:0.18s]`}
    aria-label="Main menu"
  >
    <ul data-menu-list>
      {
        nav.map((item, i) => (
          <li class="translate-y-4 opacity-0 transition-[opacity,translate] duration-700 ease-silk group-data-[open]:translate-y-0 group-data-[open]:opacity-100" style={`transition-delay: calc(0.42s + ${i} * 0.06s)`}>
            <a
              href={item.href}
              data-menu-item
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="display relative inline-block py-1 text-[clamp(34px,3.4vw,52px)] transition-opacity duration-300 aria-[current=page]:text-red"
            >
              {item.label}
              <sup class="caps absolute top-2 -right-7 text-[10px] tracking-normal text-ink/45">0{i + 1}</sup>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 opacity-0 transition-opacity delay-700 duration-700 group-data-[open]:opacity-100">
      <p class="caps text-ink/55">Services</p>
      <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-[15px]">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} class="inline-block py-1 text-ink/80 hover:text-red">
                {s.name.replace('Residential & Industrial ', '').replace(' Encapsulation & Removal', '')}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="caps mt-8 text-ink/55">Call {business.contact}</p>
      <a href={`tel:${business.phoneIntl}`} class="display text-[30px] hover:text-red">{business.phone}</a>
      <div class="mt-5 flex flex-wrap gap-5">
        {
          business.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="caps py-2 text-ink/80 hover:text-red">
              {s.name}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</div>

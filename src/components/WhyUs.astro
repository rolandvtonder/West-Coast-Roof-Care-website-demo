---
import Icon from './Icon.astro';
import {whyUs} from '../data/site';
---

<ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
  {
    whyUs.map((w, i) => (
      <li data-reveal style={`--d: ${(i % 3) * 0.08}s`}>
        <Icon name={w.icon} class="size-8 text-red-bright" />
        <h3 class="display mt-5 text-[28px]">{w.t}</h3>
        <p class="mt-2 text-white/75">{w.d}</p>
      </li>
    ))
  }
</ul>

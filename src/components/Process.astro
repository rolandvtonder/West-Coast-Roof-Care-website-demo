---
import SectionHead from './SectionHead.astro';
import {process} from '../data/site';
---

<section class="on-light bg-paper py-24 text-ink md:py-32" aria-labelledby="process-h">
  <div class="mx-auto max-w-[1680px] px-5 md:px-14">
    <div id="process-h"><SectionHead eyebrow="How we work" lines={[{t: 'Four steps to a'}, {t: 'watertight roof', i: true}]} /></div>
    <ol class="mt-16 grid gap-px bg-ink/15 sm:grid-cols-2 lg:grid-cols-4">
      {
        process.map((p, i) => (
          <li class="bg-paper p-7 md:p-9" data-reveal style={`--d: ${i * 0.08}s`}>
            <span class="display text-[64px] text-red">0{i + 1}</span>
            <h3 class="display mt-4 text-[30px]">{p.t}</h3>
            <p class="mt-3 text-ink/75">{p.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

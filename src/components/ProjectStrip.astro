---
import {Image} from 'astro:assets';
import {projects, photo} from '../data/site';
interface Props {
  images?: string[];
}
const pick = Astro.props.images ?? projects.slice(0, 4).map((p) => p.img);
const alt = (n: string) => projects.find((p) => p.img === n)?.alt ?? 'Completed West Coast Roof Care project';
---

<ul class="grid grid-cols-2 gap-[3px] lg:grid-cols-4">
  {
    pick.map((n, i) => (
      <li class="overflow-hidden" data-reveal style={`--d: ${i * 0.06}s`}>
        <Image src={photo(n)} alt={alt(n)} widths={[400, 700, 1000]} sizes="(min-width:1024px) 25vw, 50vw" class="aspect-square h-full w-full object-cover transition-transform duration-[1.2s] ease-silk hover:scale-105" />
      </li>
    ))
  }
</ul>

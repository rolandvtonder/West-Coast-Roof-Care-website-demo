---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import {photo, business} from '../data/site';
import {breadcrumbs} from '../data/seo';
const crumbs = [{name: 'About', href: '/about/'}];
---

<Base
  title="About West Coast Roof Care | Roofers in Vredenburg"
  description="West Coast Roof Care (Pty) Ltd is a Vredenburg-based roofer and waterproofer and a registered asbestos contractor, serving the West Coast and Western Cape."
  schema={[breadcrumbs(crumbs)]}
>
  <Hero
    lines={[{t: 'Local experts.'}, {t: 'Serious protection.', i: true}]}
    body="A West Coast company that has grown through genuine referrals, by going the extra mile on every roof."
    image={photo('company-van-commercial-project')}
    alt="West Coast Roof Care branded van at a commercial roofing project"
    crumbs={crumbs}
  />

  <section class="on-light bg-paper py-24 text-ink md:py-32">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 md:px-14 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHead eyebrow="Who we are" lines={[{t: 'Leading the way in'}, {t: 'roof repair', i: true}]} />
        <div class="mt-8 space-y-5 text-[18px] text-ink/85" data-reveal>
          <p>{business.legalName} is a roofing and waterproofing company based in {business.town}. We protect homes, businesses and industrial properties throughout the West Coast and the Western Cape.</p>
          <p>Our work covers waterproofing, specialised roof coatings, roof replacement, high pressure cleaning, painting and asbestos encapsulation. We have extensive experience with the conditions coastal roofs face: salt air, wind, UV and heavy winter rain.</p>
          <p>Most of our work comes from referrals. That is because we find the real cause of a problem, recommend the right system and finish what we start, on time.</p>
        </div>
        <blockquote class="display mt-10 border-l-4 border-red pl-6 text-[clamp(30px,3vw,46px)]" data-reveal>
          “Me and my team always <span class="it">go the extra mile.</span>”
          <footer class="caps mt-3 text-[12.5px] text-ink/65 not-italic">{business.contact}, West Coast Roof Care</footer>
        </blockquote>
      </div>
      <div class="grid grid-cols-2 gap-[3px]" data-reveal>
        <Image quality={72} src={photo('roof-coating-crew')} alt="Roof coating crew working safely on a steep metal roof" widths={[480, 800]} sizes="(min-width:1024px) 25vw, 50vw" class="aspect-[3/4] h-full w-full object-cover" />
        <Image quality={72} src={photo('torch-on-flame-seam')} alt="Heat-welding a torch-on waterproofing seam" widths={[480, 800]} sizes="(min-width:1024px) 25vw, 50vw" class="mt-12 aspect-[3/4] h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="bg-ink py-24 md:py-32">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <SectionHead eyebrow="What we stand for" lines={[{t: 'You can trust our'}, {t: 'local experts', i: true}]} />
      <div class="mt-16"><WhyUs /></div>
    </div>
  </section>

  <section class="bg-red py-20 md:py-24">
    <div class="mx-auto flex max-w-[1680px] flex-wrap items-center justify-between gap-8 px-5 md:px-14">
      <div class="max-w-[62ch]">
        <p class="caps text-white/80">Registered asbestos contractor</p>
        <p class="mt-3 text-[19px]">Approved by the Department of Employment and Labour to perform Type 2 work in terms of Regulation 12 of the Asbestos Abatement Regulations 2020.</p>
      </div>
      <a href={business.certificate} target="_blank" rel="noopener" class="btn btn-white">View certificate (PDF) <Icon name="file" class="size-4" /></a>
    </div>
  </section>

  <Process />
  <Reviews />
</Base>

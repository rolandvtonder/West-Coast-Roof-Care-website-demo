---
import Base from '../layouts/Base.astro';
import {nav} from '../data/site';
---

<Base title="Page not found | West Coast Roof Care" description="The page you were looking for could not be found." noindex>
  <section class="flex min-h-svh items-center bg-ink">
    <div class="mx-auto max-w-[1680px] px-5 py-32 md:px-14">
      <p class="caps text-white/65">Error 404</p>
      <h1 class="display mt-4 text-[clamp(52px,8vw,140px)]"><span class="block">This page has</span><span class="it block">sprung a leak.</span></h1>
      <p class="mt-8 max-w-[52ch] text-[18px] text-white/85">The page you were looking for has moved or no longer exists. Try one of these instead:</p>
      <ul class="mt-8 flex flex-wrap gap-3">
        {nav.map((n) => <li><a href={n.href} class="btn btn-ghost">{n.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

---
import {Image} from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import {photo, projects} from '../data/site';
import {breadcrumbs} from '../data/seo';
const crumbs = [{name: 'Projects', href: '/projects/'}];
const cats = ['All', ...new Set(projects.map((p) => p.cat))];
---

<Base
  title="Roofing & Waterproofing Projects | West Coast Roof Care"
  description="See recent waterproofing, roof coating, roof replacement and painting projects by West Coast Roof Care in Vredenburg, Langebaan, Saldanha and the West Coast."
  schema={[breadcrumbs(crumbs)]}
>
  <Hero
    lines={[{t: 'Built to protect.'}, {t: 'Built to last.', i: true}]}
    body="A selection of recent roofs, flat-roof waterproofing and renovations across the West Coast."
    image={photo('aerial-roof-coating-topdown')}
    alt="Aerial view of metal roofs coated by West Coast Roof Care"
    crumbs={crumbs}
  />

  <section class="bg-ink py-16 md:py-24">
    <div class="mx-auto max-w-[1680px] px-5 md:px-14">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects">
        {
          cats.map((c, i) => (
            <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'} class="caps min-h-11 cursor-pointer bg-white/10 px-5 py-2 transition-colors hover:bg-white/20 aria-pressed:bg-red">
              {c}
            </button>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-count></p>
      <p class="mt-8 max-w-[68ch] text-[18px] text-white/85">
        Real jobs by our own team: torch-on and liquid waterproofing on flat roofs and box gutters, rust-proof coatings on metal roofs, full roof replacements on double-storey homes, and painting for homes and commercial buildings. Filter by type, or tap any photo to see it larger.
      </p>
    </div>
    <ul class="mt-10 columns-2 gap-[3px] px-[3px] md:columns-3 xl:columns-4">
      {
        projects.map((p) => (
          <li data-cat={p.cat} class="mb-[3px] break-inside-avoid">
            <button type="button" class="group relative block w-full cursor-zoom-in overflow-hidden" data-open aria-label={`Enlarge: ${p.alt}`}>
              <Image quality={72} src={photo(p.img)} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width:1280px) 25vw, (min-width:768px) 33vw, 50vw" class="w-full transition-transform duration-[1.2s] ease-silk group-hover:scale-105" />
              <span class="caps absolute bottom-3 left-3 bg-ink/80 px-3 py-1 text-[11px] opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">{p.cat}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <dialog data-lightbox class="m-auto max-h-[92vh] max-w-[92vw] bg-transparent p-0 backdrop:bg-ink/90" aria-label="Project photo">
    <img data-lightbox-img alt="" class="max-h-[82vh] w-auto" />
    <div class="mt-3 flex items-center justify-between gap-6 text-white">
      <p data-lightbox-cap class="text-[15px]"></p>
      <button type="button" data-close class="caps min-h-11 cursor-pointer bg-white px-5 text-ink" autofocus>Close</button>
    </div>
  </dialog>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-cat]');
  const count = document.querySelector('[data-count]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter ?? 'All';
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      items.forEach((it) => {
        const show = f === 'All' || it.dataset.cat === f;
        it.hidden = !show;
        if (show) n++;
      });
      if (count) count.textContent = `Showing ${n} ${f === 'All' ? '' : f.toLowerCase() + ' '}projects`;
    }),
  );

  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const big = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  const cap = dlg.querySelector('[data-lightbox-cap]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img')!;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      cap.textContent = img.alt;
      dlg.showModal();
    }),
  );
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>

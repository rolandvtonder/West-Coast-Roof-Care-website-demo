# West Coast Roof Care: Apache / cPanel settings

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain (one canonical address for SEO)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://wcroofcare.co.za/$1 [L,R=301]

  # Old WordPress URLs -> new pages (keeps existing Google rankings)
  RewriteRule ^about-our-company/?$ /about/ [L,R=301]
  RewriteRule ^our-services/services/?$ /services/ [L,R=301]
  RewriteRule ^our-services/?$ /services/ [L,R=301]
  RewriteRule ^2026/09/22/[^/]*water-damage[^/]*/?$ /services/waterproofing/ [L,R=301,NC]
  RewriteRule ^2026/09/22/[^/]*coating[^/]*/?$ /services/roof-coating/ [L,R=301,NC]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php).*$ / [L,R=301]

  # Add the trailing slash to page URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-z0-9]{2,5})$ [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# Caching: hashed build assets are immutable; pages revalidate.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^_astro/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
